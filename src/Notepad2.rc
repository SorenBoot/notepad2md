        BEGIN
            MENUITEM "无(&N)",                       IDM_VIEW_NOESCFUNC
            MENUITEM "最小化 notepad2md(&M)",          IDM_VIEW_ESCMINIMIZE
            MENUITEM "退出 notepad2md(&X)",              IDM_VIEW_ESCEXIT
