        MENUITEM "退出时保存设置(&X)",      IDM_VIEW_SAVESETTINGS
        MENUITEM "立即保存设置(&N)\tF7",      IDM_VIEW_SAVESETTINGSNOW
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A)...\tF1",               IDM_HELP_ABOUT
    END
END

IDR_POPUPMENU MENU
BEGIN
    POPUP "+"
    BEGIN
        MENUITEM "撤销(&U)",                       IDM_EDIT_UNDO
        MENUITEM "恢复(&R)",                       IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)",                        IDM_EDIT_CUT
        MENUITEM "复制(&C)",                       IDM_EDIT_COPY
        MENUITEM "粘贴(&P)",                      IDM_EDIT_PASTE
        MENUITEM "清除(&E)",                      IDM_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "全选(&A)",                 IDM_EDIT_SELECTALL
    END
    POPUP "+"
    BEGIN
        MENUITEM "显示工具栏(&T)",               IDM_VIEW_TOOLBAR
        MENUITEM "自定义工具栏(&C)...",       IDM_VIEW_CUSTOMIZETB
        MENUITEM "显示状态栏(&S)",             IDM_VIEW_STATUSBAR
    END
    POPUP "+"
    BEGIN
        MENUITEM "打开 notepad2md",               IDM_TRAY_RESTORE
        MENUITEM "退出 notepad2md",               IDM_TRAY_EXIT
    END
END


