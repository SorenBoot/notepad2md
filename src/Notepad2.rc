/////////////////////////////////////////////////////////////////////////////
//
// Chinese (Simplified, PRC) resources
//

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
#ifdef _WIN32
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)
#endif //_WIN32


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//
// The original project kept this commented out: MSVC embeds res/Notepad2.exe.manifest
// via the linker, so the .rc never needed it.  MinGW does not, so the exe had no
// manifest at all and therefore loaded comctl32 v5 - the Win2000 look.  That is why
// the toolbar band and the status bar came out a few pixels taller than the reference
// build (16+2*4+6=30 vs 16+2*4+2=26), which pushed Scintilla down and clipped the
// right end of the toolbar.  Embed it here so the app gets themed comctl32 v6 controls.
//
IDR_RT_MANIFEST         RT_MANIFEST             "..\\res\\Notepad2.exe.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINWND             ICON                    "..\\res\\Notepad2.ico"
IDI_RUN                 ICON                    "..\\res\\Run.ico"
IDI_STYLES              ICON                    "..\\res\\Styles.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINWND             BITMAP                  "..\\res\\Toolbar.bmp"
IDB_OPEN                BITMAP                  "..\\res\\Open.bmp"
IDB_NEXT                BITMAP                  "..\\res\\Next.bmp"
IDB_PREV                BITMAP                  "..\\res\\Prev.bmp"
IDB_PICK                BITMAP                  "..\\res\\Pick.bmp"
IDB_ENCODING            BITMAP                  "..\\res\\Encoding.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Cursor
//

IDC_COPY                CURSOR                  "..\\res\\Copy.cur"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINWND MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)\tCtrl+N",                IDM_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",            IDM_FILE_OPEN
        MENUITEM "还原(&V)\tF5",                 IDM_FILE_REVERT
        MENUITEM "保存(&S)\tCtrl+S",               IDM_FILE_SAVE
        MENUITEM "另存为(&A)...\tF6",             IDM_FILE_SAVEAS
        MENUITEM "保存副本(&C)...\tCtrl+F6",      IDM_FILE_SAVECOPY
        MENUITEM "只读(&R)",                  IDM_FILE_READONLY
        MENUITEM SEPARATOR
        POPUP "启动(&L)"
        BEGIN
            MENUITEM "新建窗口(&N)\tAlt+N",          IDM_FILE_NEWWINDOW
            MENUITEM "空白窗口(&E)\tAlt+0",        IDM_FILE_NEWWINDOW2
            MENUITEM SEPARATOR
            MENUITEM "执行文档(&D)\tCtrl+L",   IDM_FILE_LAUNCH
            MENUITEM "打开方式(&O)...\tAlt+L",        IDM_FILE_OPENWITH
            MENUITEM "命令(&C)...\tCtrl+R",         IDM_FILE_RUN
        END
        MENUITEM SEPARATOR
        POPUP "编码(&E)"
        BEGIN
            MENUITEM "ANSI(&A)",                       IDM_ENCODING_ANSI
            MENUITEM "Unicode(&U)",                    IDM_ENCODING_UNICODE
            MENUITEM "Unicode 大端(&B)",         IDM_ENCODING_UNICODEREV
            MENUITEM "UTF-8(&8)",                      IDM_ENCODING_UTF8
            MENUITEM "带签名的 UTF-8(&S)",       IDM_ENCODING_UTF8SIGN
            MENUITEM "更多(&M)...\tF9",                IDM_ENCODING_SELECT
            MENUITEM SEPARATOR
            MENUITEM "重新编码(&R)...\tF8",              IDM_ENCODING_RECODE
            MENUITEM SEPARATOR
            MENUITEM "默认(&D)...",                 IDM_ENCODING_SETDEFAULT
        END
        POPUP "换行符(&G)"
        BEGIN
            MENUITEM "Windows (CR+LF)(&W)",            IDM_LINEENDINGS_CRLF
            MENUITEM "Unix (LF)(&U)",                  IDM_LINEENDINGS_LF
            MENUITEM "Mac (CR)(&M)",                   IDM_LINEENDINGS_CR
            MENUITEM SEPARATOR
            MENUITEM "默认(&D)...",                 IDM_LINEENDINGS_SETDEFAULT

        END
        MENUITEM SEPARATOR
        MENUITEM "页面设置(&T)...",              IDM_FILE_PAGESETUP
        MENUITEM "打印(&P)...\tCtrl+P",           IDM_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "属性(&I)...",              IDM_FILE_PROPERTIES
        MENUITEM "创建桌面快捷方式(&D)",        IDM_FILE_CREATELINK
        MENUITEM SEPARATOR
        POPUP "收藏夹(&F)"
        BEGIN
            MENUITEM "打开收藏夹(&O)...\tAlt+I",   IDM_FILE_OPENFAV
            MENUITEM "添加当前文件(&A)...\tAlt+K", IDM_FILE_ADDTOFAV
            MENUITEM "管理(&M)...\tAlt+F9",          IDM_FILE_MANAGEFAV
        END
        MENUITEM "最近历史(&H)...\tAlt+H", IDM_FILE_RECENT
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAlt+F4",               IDM_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤销(&U)\tCtrl+Z",               IDM_EDIT_UNDO
        MENUITEM "恢复(&R)\tCtrl+Y",               IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",                IDM_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",               IDM_EDIT_COPY
        MENUITEM "全部复制(&L)\tAlt+C",            IDM_EDIT_COPYALL
        MENUITEM "复制并添加(&A)\tCtrl+E",           IDM_EDIT_COPYADD
        MENUITEM "粘贴(&P)\tCtrl+V",              IDM_EDIT_PASTE
        MENUITEM "交换(&W)\tCtrl+K",               IDM_EDIT_SWAP
        MENUITEM "清除\tDel",                  IDM_EDIT_CLEAR
        MENUITEM "清除剪贴板(&D)",            IDM_EDIT_CLEARCLIPBOARD
        MENUITEM "全选(&S)\tCtrl+A",         IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        POPUP "行(&I)"
        BEGIN
            MENUITEM "上移(&U)\tCtrl+Shift+Up",     IDM_EDIT_MOVELINEUP
            MENUITEM "下移(&M)\tCtrl+Shift+Down", IDM_EDIT_MOVELINEDOWN
            MENUITEM SEPARATOR
            MENUITEM "复制行(&D)\tCtrl+D",     IDM_EDIT_DUPLICATELINE
            MENUITEM "剪切行(&C)\tCtrl+Shift+X",     IDM_EDIT_CUTLINE
            MENUITEM "拷贝行(&O)\tCtrl+Shift+C",    IDM_EDIT_COPYLINE
            MENUITEM "删除行(&E)\tCtrl+Shift+D",  IDM_EDIT_DELETELINE
            MENUITEM SEPARATOR
            MENUITEM "按列换行(&W)...\tCtrl+Shift+W", IDM_EDIT_COLUMNWRAP
            MENUITEM "拆分行(&S)\tCtrl+I",        IDM_EDIT_SPLITLINES
            MENUITEM "合并行(&J)\tCtrl+J",         IDM_EDIT_JOINLINES
            MENUITEM "合并段落(&P)\tCtrl+Shift+J", IDM_EDIT_JOINLINESEX
        END
        POPUP "块(&B)"
        BEGIN
            MENUITEM "增加缩进(&I)\tTab",                IDM_EDIT_INDENT
            MENUITEM "减少缩进(&U)\tShift+Tab",        IDM_EDIT_UNINDENT
            MENUITEM SEPARATOR
